{
  "name": "videodl",
  "version": "0.1.0",
  "description": "Linux Terminal Video Downloader with interactive TUI and CLI backed by yt-dlp and FFmpeg",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "videodl": "./bin/videodl.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "tui",
    "cli",
    "ink",
    "linux"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
